<?xml version="1.0" encoding="utf-8"?>
<!--
  The client talks to hosts the user owns: a DSH bridge or another local gateway
  on loopback, or on the LAN over plain HTTP. Android blocks cleartext by default
  from targetSdk 28, so it is enabled here for the private ranges only — public
  hosts still have to use TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
